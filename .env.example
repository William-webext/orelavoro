# Copia in .env per lo sviluppo locale (non committare mai .env).
PORT=3000
DATA_DIR=./data
APP_TZ=Europe/Lisbon
APP_URL=http://localhost:3000

# Superadmin creato al primo avvio, solo se non esiste ancora nessun utente.
SUPERADMIN_USER=admin
SUPERADMIN_PIN=123456
SUPERADMIN_NAME=Amministratore
SUPERADMIN_EMAIL=

# SMTP (facoltativo: senza, report e promemoria via mail sono disattivati)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
